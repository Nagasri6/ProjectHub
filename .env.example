# Frontend
# Local Vite proxy: /api -> http://localhost:5000
# Production build: set this to the hosted API, e.g. https://your-api.example.com/api
VITE_API_URL=/api

# Backend
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Required in production. Comma-separated extras: CORS_ORIGINS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

MONGODB_URI=mongodb://127.0.0.1:27017/projecthub
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads

# Development only. Auto-seed runs on empty local DBs unless SEED=false.
# Production never auto-seeds. `npm run seed` is refused when NODE_ENV=production.
SEED=
